# --- Web app (safe for the browser; Row-Level Security decides access) ---
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used to build invite and email-confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only: never prefix these with NEXT_PUBLIC_ ---
# Supabase → Project Settings → API keys → Secret key. Used ONLY by background
# jobs and the Meta webhook (bypasses Row-Level Security).
SUPABASE_SECRET_KEY=
# Meta app → Settings → Basic → App secret. Verifies webhook signatures.
# Comma-separate two values while rotating.
META_APP_SECRET=
# Any random string; enter the same value in Meta's webhook setup.
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v23.0

# --- Background jobs (Inngest) ---
# Local: run `npm run inngest:dev` and keep INNGEST_DEV=1.
INNGEST_DEV=1
# Production: from the Inngest dashboard; remove INNGEST_DEV.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- WhatsApp bot ---
# Google Gemini key for understanding typed messages (optional: without it the
# bot still works with buttons and keywords, and hands other messages to you).
GEMINI_API_KEY=
# Development only: log WhatsApp messages instead of sending them.
# WA_DRY_RUN=1
