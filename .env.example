# Supabase → Project Settings → API. The publishable (anon) key is safe for the
# browser because Row-Level Security decides what it can see.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used to build invite and email-confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
